# AIRIS Web Dashboard Environment Template
# Copy this file to .env.local and replace placeholders with your actual development keys.
# NEVER commit your actual .env.local file.

# Firebase Configuration for Next.js Web Dashboard
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_API_URL=https://18-143-33-249.sslip.io
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_MEASUREMENT_ID=your_measurement_id_here

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Server Configuration for Admin Two-Factor Authentication (OTP)
# (Used server-side by Next.js route handlers - NEVER prefix with NEXT_PUBLIC_)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="AIRIS Security" <noreply@airis.edu.ph>

# Secret key for OTP challenge hashing and session signing
OTP_SECRET_KEY=generate_a_random_32_character_secret_key
