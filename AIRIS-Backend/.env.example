# AIRIS Backend Environment Template
# Copy this file to .env and replace placeholders with your actual development keys.
# NEVER commit your actual .env file.

# AI Provider API Keys (At least one required for full LLM analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Backend CORS & Security
FRONTEND_URL=http://localhost:8081
ADMIN_UIDS=your_admin_firebase_uid_1,your_admin_firebase_uid_2

# SBERT Model Configuration (Optional overrides)
SBERT_MODEL=all-MiniLM-L6-v2
SBERT_DEVICE=cpu
SBERT_MATCH_THRESHOLD=0.82
