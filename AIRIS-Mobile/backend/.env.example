# AIRIS Backend Environment Variables Example
# Duplicate this file to '.env' inside the backend folder and fill in the required API keys.
# Do NOT check the '.env' file into git source control.

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Selected Provider (options: openai, gemini, groq, openrouter)
AI_PROVIDER=gemini