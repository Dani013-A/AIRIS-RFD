# AIRIS Mobile Environment Template
# Copy this file to .env and replace placeholders with your actual development keys.
# NEVER commit your actual .env file.

# Firebase Client Configuration (Required for Auth & Database)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
EXPO_PUBLIC_MEASUREMENT_ID=your_measurement_id_here

# Google OAuth Client ID (Required for Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Backend API Endpoint
# For web/emulator development: http://localhost:8000
# For physical mobile device testing: http://YOUR_LAN_IP:8000 (e.g. http://192.168.1.15:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# YouTube Data API Key (Optional for career video recommendations)
EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here
