{
  "expo": {
    "name": "AIRIS-Mobile",
    "slug": "AIRIS-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/airis-app.png",
    "scheme": "airismobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airis.mobile"
    },
    "android": {
      "package": "com.airis.mobile",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/airis-app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91d51e57-220e-456c-ace3-8aaa09a0ad80"
      }
    }
  }
}
