{
  "expo": {
    "name": "AIRIS",
    "slug": "AIRIS-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/airis-logo-real-final.png",
    "scheme": "airismobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airis.mobile"
    },
    "android": {
      "package": "com.airis.mobile",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/airis-logo-real-final.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/airis-logo-real-final.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AIRIS to access your photo library to select resume image files.",
          "cameraPermission": "Allow AIRIS to access your camera to capture paper resume photos for OCR analysis."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AIRIS to access your microphone for interview voice responses."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91d51e57-220e-456c-ace3-8aaa09a0ad80"
      }
    }
  }
}
