rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user is an administrator
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Student and Admin profiles collection rules
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /resumes/{resumeId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /resumeAnalyses/{analysisId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Collection Group rules to permit querying resumes and resumeAnalyses across all users
    match /{path=**}/resumes/{resumeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /{path=**}/resumeAnalyses/{analysisId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Security compliance audit logs
    match /auditLogs/{logId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // Curated learning materials library & verified dynamic catalog
    match /learningMaterials/{materialId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /learning_resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /learning_categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /learning_catalog_metadata/{metaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
