rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user is an administrator
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token != null && request.auth.token.admin == true) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Student and Admin profiles collection rules (including all subcollections)
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Collection Group rules to permit querying subcollections across all users for admins
    match /{path=**}/resumes/{resumeId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/resumeAnalyses/{analysisId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/interviews/{interviewId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/activities/{activityId} {
      allow read: if request.auth != null && isAdmin();
    }

    // Security compliance audit logs (admin only)
    match /auditLogs/{logId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // Curated learning materials library & verified dynamic catalog
    match /learningMaterials/{materialId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /learning_resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /learning_categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /learning_catalog_metadata/{metaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
