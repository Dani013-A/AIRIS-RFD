rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    

    // Helper function to check if the requesting user is a System Administrator
    // Also verifies the account is not disabled
    function isSystemAdmin() {
      return request.auth != null && isActiveUser(request.auth.uid) && (
        (request.auth.token != null && request.auth.token.get('admin', false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled != true)
      );
    }

    // Institutional staff with institution-wide access (Admin & Career Center)
    function isInstitutionalStaff() {
      return request.auth != null && isActiveUser(request.auth.uid) && (
        (request.auth.token != null && request.auth.token.get('admin', false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'career_center'] &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled != true)
      );
    }

    // OJT Coordinator program scoping boundary
    function isAssignedCoordinator(program) {
      return request.auth != null && isActiveUser(request.auth.uid) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ojt_coordinator' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled != true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedProgram', '') == program;
    }

    function canReadUserData(userData) {
      return isInstitutionalStaff() || (
        userData.get('role', 'student') == 'student' &&
        isAssignedCoordinator(userData.get('degreeProgram', ''))
      );
    }

    // Helper function to check if the requesting user is an authorized staff member or administrator
    function isStaffOrAdmin() {
      return request.auth != null && isActiveUser(request.auth.uid) && (
        (request.auth.token != null && request.auth.token.get('admin', false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'career_center', 'ojt_coordinator'] &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled != true)
      );
    }

    function isActiveUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('isDeleted', false) != true &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('isDisabled', false) != true &&
        !(get(/databases/$(database)/documents/users/$(userId)).data.get('accountState', 'ACTIVE') in ['DELETED', 'DISABLED']);
    }

    // Identity and restriction state is written only by the authenticated lifecycle server.
    match /account_lifecycle/{identity} { allow read, write: if false; }
    match /account_lifecycle_control/{control} { allow read, write: if false; }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || canReadUserData(resource.data));
      allow create, delete: if false;
      allow update: if request.auth != null && isActiveUser(request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'role', 'assignedProgram', 'accountState', 'isDeleted', 'isDisabled', 'deletionOrigin', 'deletedAt', 'deletedBy'
        ]) && (
          isInstitutionalStaff() || (request.auth.uid == userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        );

      // Score integrity: Completed interview evaluations and final scores are persisted exclusively
      // by the trusted backend Admin SDK. Direct client creation and updates are disallowed.
      match /interviews/{interviewId} {
        allow read: if request.auth != null && (
          (request.auth.uid == userId && isActiveUser(userId)) ||
          isInstitutionalStaff() ||
          isAssignedCoordinator(get(/databases/$(database)/documents/users/$(userId)).data.get('degreeProgram', ''))
        );
        allow write: if false;
      }

      // Server-owned state is private, including all answer-attempt receipts.
      match /interviewSessions/{sessionId}/{document=**} { allow read, write: if false; }

      match /activities/{activityId} {
        allow create: if request.auth != null && request.auth.uid == userId && isActiveUser(userId)
          && request.resource.data.get('type', '') == 'Resume Analysis'
          && !request.resource.data.keys().hasAny(['persistedBy']);
        allow update, delete: if request.auth != null && request.auth.uid == userId && isActiveUser(userId)
          && resource.data.get('type', '') == 'Resume Analysis'
          && !resource.data.keys().hasAny(['persistedBy'])
          && (request.method == 'delete' || (request.resource.data.get('type', '') == 'Resume Analysis'
            && !request.resource.data.keys().hasAny(['persistedBy'])));
      }

      match /{subcollection}/{docId} {
        allow read: if request.auth != null && subcollection != 'interviewSessions' && (
          (request.auth.uid == userId && isActiveUser(userId)) ||
          isInstitutionalStaff() ||
          isAssignedCoordinator(get(/databases/$(database)/documents/users/$(userId)).data.get('degreeProgram', ''))
        );
        allow write: if request.auth != null && !(subcollection in ['interviews', 'interviewSessions', 'activities']) &&
          ((request.auth.uid == userId && isActiveUser(userId)) || isInstitutionalStaff());
      }
    }

    // Collection Group rules to permit querying subcollections across all users for institutional staff (Admin & Career Center)
    match /{path=**}/resumes/{resumeId} {
      allow read: if request.auth != null && isInstitutionalStaff();
    }

    match /{path=**}/resumeAnalyses/{analysisId} {
      allow read: if request.auth != null && isInstitutionalStaff();
    }

    match /{path=**}/interviews/{interviewId} {
      allow read: if request.auth != null && isInstitutionalStaff();
    }

    match /{path=**}/activities/{activityId} {
      allow read: if request.auth != null && isInstitutionalStaff();
    }

    // Security compliance audit logs: append-only, tamper-proof
    match /auditLogs/{logId} {
      allow read: if request.auth != null && isStaffOrAdmin();
      allow create: if request.auth != null && isStaffOrAdmin();
      allow update, delete: if false; // Audit logs must not be modified or deleted by clients
    }

    // Curated learning materials library & verified dynamic catalog
    // Write access restricted to System Administrators only
    match /learningMaterials/{materialId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    match /learning_resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    match /learning_categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    match /learning_catalog_metadata/{metaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    // Market intelligence snapshots — read for authenticated users, write for system admins only
    match /market_intelligence/{snapshotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }
  }
}
