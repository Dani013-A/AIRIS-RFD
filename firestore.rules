rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user is an authorized staff member or administrator
    // Also verifies the account is not disabled
    function isStaffOrAdmin() {
      return request.auth != null && (
        (request.auth.token != null && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'career_center', 'ojt_coordinator'] &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled != true)
      );
    }

    // Helper function to check if the requesting user is a System Administrator
    // Also verifies the account is not disabled
    function isSystemAdmin() {
      return request.auth != null && (
        (request.auth.token != null && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled != true)
      );
    }

    // Student and Admin profiles collection rules
    match /users/{userId} {
      // 1. Read: Allow users to read their own profile, or staff/admins
      allow read: if request.auth != null && (request.auth.uid == userId || isStaffOrAdmin());
      // 2. Create: Authenticated student initializing their own active profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == "student"
                    && request.resource.data.accountState == "ACTIVE"
                    && request.resource.data.isDeleted == false
                    && request.resource.data.isDisabled == false;

      // 3. Update:
      // - Staff/Admins can update accounts (e.g. block/unblock, edit coordinator)
      // - Non-admin users can update their own profile ONLY IF:
      //   a) Existing document is not deleted or disabled
      //   b) User does not escalate role
      //   c) User does not modify protected fields (uid, email)
      //   d) Either normal profile update or self-deletion
      allow update: if request.auth != null && resource != null && (
        isStaffOrAdmin() || (
          request.auth.uid == userId &&
          resource.data.isDeleted != true &&
          resource.data.accountState != "DELETED" &&
          resource.data.isDisabled != true &&
          resource.data.accountState != "DISABLED" &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
          (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
          (
            (
              (!('accountState' in request.resource.data) || request.resource.data.accountState == resource.data.accountState) &&
              (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted == resource.data.isDeleted) &&
              (!('isDisabled' in request.resource.data) || request.resource.data.isDisabled == resource.data.isDisabled)
            ) ||
            (
              request.resource.data.accountState == "DELETED" &&
              request.resource.data.isDeleted == true &&
              request.resource.data.isDisabled == true
            )
          )
        )
      );

      // 4. Delete: Normal users cannot hard-delete user documents; System Admin only
      allow delete: if request.auth != null && isSystemAdmin();

      // 5. User subcollections
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isStaffOrAdmin());
      }
    }

    // Collection Group rules to permit querying subcollections across all users for staff/admins
    match /{path=**}/resumes/{resumeId} {
      allow read: if request.auth != null && isStaffOrAdmin();
    }

    match /{path=**}/resumeAnalyses/{analysisId} {
      allow read: if request.auth != null && isStaffOrAdmin();
    }

    match /{path=**}/interviews/{interviewId} {
      allow read: if request.auth != null && isStaffOrAdmin();
    }

    match /{path=**}/activities/{activityId} {
      allow read: if request.auth != null && isStaffOrAdmin();
    }

    // Security compliance audit logs: append-only, tamper-proof
    match /auditLogs/{logId} {
      allow read: if request.auth != null && isStaffOrAdmin();
      allow create: if request.auth != null && isStaffOrAdmin();
      allow update, delete: if false; // Audit logs must not be modified or deleted by clients
    }

    // Curated learning materials library & verified dynamic catalog
    // Write access restricted to System Administrators only
    match /learningMaterials/{materialId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    match /learning_resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    match /learning_categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    match /learning_catalog_metadata/{metaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }

    // Market intelligence snapshots — read for authenticated users, write for system admins only
    match /market_intelligence/{snapshotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSystemAdmin();
    }
  }
}
